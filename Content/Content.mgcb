# MonoGame Content Pipeline Configuration
# Tecmo Super Bowl Remake

/outputDir:bin/DesktopGL
/intermediateDir:obj/DesktopGL
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#----------------------------------
# Sprites (Player/Entity Graphics)
#----------------------------------

# Player sprites from Bank 10
#/importer:TextureImporter
#/processor:TextureProcessor
#/processorParam:ColorKeyColor=255,0,255,255
#/processorParam:ColorKeyEnabled=True
#/processorParam:GenerateMipmaps=False
#/processorParam:PremultiplyAlpha=True
#/processorParam:ResizeToPowerOfTwo=False
#/processorParam:MakeSquare=False
#/processorParam:TextureFormat=Color
#/build:Sprites/players.png

#----------------------------------
# Field/Tiles (Background Graphics)
#----------------------------------

# Field tiles from Banks 11-12
#/importer:TextureImporter
#/processor:TextureProcessor
#/processorParam:ColorKeyEnabled=False
#/processorParam:PremultiplyAlpha=True
#/processorParam:TextureFormat=Color
#/build:Tiles/field_tiles.png

#----------------------------------
# Textures
#----------------------------------

/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:PremultiplyAlpha=True
/build:Textures/DebugSprites.png

#----------------------------------
# Fonts
#----------------------------------

/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:TextureFormat=Compressed
/build:Fonts/Playcall.spritefont
/build:Fonts/UiSmall.spritefont
/build:Fonts/UiMedium.spritefont
/build:Fonts/UiLarge.spritefont

#----------------------------------
# Audio
#----------------------------------

/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:Quality=Best
/build:Audio/snap.wav
/build:Audio/whistle.wav
/build:Audio/tackle.wav
/build:Audio/incomplete.wav
/build:Audio/turnover.wav
/build:Audio/touchdown.wav
/build:Audio/menu_move.wav
/build:Audio/menu_select.wav

# Music (to be converted from NES format)
#/importer:Mp3Importer
#/processor:SongProcessor
#/processorParam:Quality=Best
#/build:Audio/music_title.mp3
