<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="Arch.EventBus" Version="1.0.2" />
    <PackageReference Include="Gum.MonoGame" Version="2026.3.14.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TecmoSB\TecmoSB.csproj" />
  </ItemGroup>

  <!--
    Legacy MonoGame.Extended.Entities (MGE) sim code has been retired.
    We keep the files in git history/branches, but exclude them from compilation.
  -->
  <ItemGroup>
    <Compile Remove="ArchiveMge/**" />

    <Compile Remove="Components/**" />
    <Compile Remove="Factories/**" />
    <Compile Remove="Flow/**" />
    <Compile Remove="Input/**" />
    <Compile Remove="Replay/**" />
    <Compile Remove="Spawning/**" />
    <Compile Remove="State/**" />
    <Compile Remove="Systems/**" />
    <Compile Remove="Events/**" />
    <Compile Remove="Headless/**" />

    <!-- Rendering: keep only Arch snapshot rendering + field + sprite registry -->
    <Compile Remove="Rendering/**" />
    <Compile Include="Rendering/RenderViewport.cs" />
    <Compile Include="Rendering/RenderResources.cs" />
    <Compile Include="Rendering/FieldRenderer.cs" />
    <Compile Include="Rendering/SimRenderer.cs" />
    <Compile Include="Rendering/Hud/**" />
    <Compile Include="Rendering/UI/**" />
    <Compile Include="Rendering/Sprites/**" />

    <Compile Remove="MainGame.cs" />
    <Compile Remove="SimArch/SimMode.cs" />
  </ItemGroup>

  <!-- Build MonoGame content (XNB) into the app output folder. -->
  <Target Name="BuildMonoGameContent" AfterTargets="Build">
    <!-- Run MGCB with explicit output/intermediate dirs so the game can load Content/*.xnb from $(TargetDir). -->
    <PropertyGroup>
      <_ContentDir>$(ProjectDir)..\..\Content</_ContentDir>
      <_MgcbIntermediate>$(BaseIntermediateOutputPath)mgcb</_MgcbIntermediate>
      <_MgcbOutput>$(TargetDir)Content</_MgcbOutput>
      <_MgcbTool>$(UserProfile)/.dotnet/tools/mgcb</_MgcbTool>
    </PropertyGroup>

    <!-- Prefer the user-installed global tool path if present; fallback to PATH lookup. -->
    <Exec WorkingDirectory="$(_ContentDir)" Condition="Exists('$(_MgcbTool)')" Command="&quot;$(_MgcbTool)&quot; -q /@:&quot;Content.mgcb&quot; /outputDir:&quot;$(_MgcbOutput)&quot; /intermediateDir:&quot;$(_MgcbIntermediate)&quot;" />

    <Exec WorkingDirectory="$(_ContentDir)" Condition="!Exists('$(_MgcbTool)')" Command="mgcb -q /@:&quot;Content.mgcb&quot; /outputDir:&quot;$(_MgcbOutput)&quot; /intermediateDir:&quot;$(_MgcbIntermediate)&quot;" />
  </Target>

</Project>
