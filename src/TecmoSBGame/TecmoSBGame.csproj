<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Extended.Entities" Version="3.9.0-prerelease.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TecmoSB\TecmoSB.csproj" />
  </ItemGroup>

  <!-- Build MonoGame content (XNB) into the app output folder. -->
  <Target Name="BuildMonoGameContent" AfterTargets="Build">
    <!-- Run MGCB with explicit output/intermediate dirs so the game can load Content/*.xnb from $(TargetDir). -->
    <PropertyGroup>
      <_ContentDir>$(ProjectDir)..\..\Content</_ContentDir>
      <_MgcbIntermediate>$(BaseIntermediateOutputPath)mgcb</_MgcbIntermediate>
      <_MgcbOutput>$(TargetDir)Content</_MgcbOutput>
    </PropertyGroup>

    <Exec WorkingDirectory="$(_ContentDir)" Command="mgcb -q /@:&quot;Content.mgcb&quot; /outputDir:&quot;$(_MgcbOutput)&quot; /intermediateDir:&quot;$(_MgcbIntermediate)&quot;" />
  </Target>

</Project>
